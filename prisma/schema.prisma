generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  currency  String   @default("USD")
  users     User[]
  assets    Asset[]
  createdAt DateTime @default(now())
}

model User {
  id             String         @id @default(cuid())
  email          String         @unique
  password       String?
  name           String?
  role           String         @default("EMPLOYEE")
  organizationId String
  organization   Organization   @relation(fields: [organizationId], references: [id])
  assets         Asset[]
  history        AssetHistory[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
}

model Asset {
  id              String              @id @default(cuid())
  name            String
  assetTag        String              @unique
  category        String
  status          String              @default("AVAILABLE")
  organizationId  String
  organization    Organization        @relation(fields: [organizationId], references: [id])
  assignedToId    String?
  assignedTo      User?               @relation(fields: [assignedToId], references: [id])
  history         AssetHistory[]
  maintenanceLogs MaintenanceLog[]
  attachments     Attachment[]
  hardware        HardwareSpec?
  networks        NetworkInterface[]
  storage         StorageDrive[]
  software        InstalledSoftware[]
  teledeployTasks TeledeployTask[]    // <-- THE MISSING RELATION LINK
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
}

model AssetHistory {
  id        String   @id @default(cuid())
  assetId   String
  asset     Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  action    String
  notes     String?
  createdAt DateTime @default(now())
}

model MaintenanceLog {
  id        String   @id @default(cuid())
  assetId   String
  asset     Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  issue     String
  status    String   @default("IN_PROGRESS")
  priority  String   @default("LOW")
  createdAt DateTime @default(now())
}

model HardwareSpec {
  id         String   @id @default(cuid())
  assetId    String   @unique
  asset      Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  osName     String?
  osVersion  String?
  cpuModel   String?
  ramTotalMB Int?
  lastSyncAt DateTime @default(now())
}

model NetworkInterface {
  id         String  @id @default(cuid())
  assetId    String
  asset      Asset   @relation(fields: [assetId], references: [id], onDelete: Cascade)
  macAddress String
  ipAddress  String?
}

model StorageDrive {
  id         String @id @default(cuid())
  assetId    String
  asset      Asset  @relation(fields: [assetId], references: [id], onDelete: Cascade)
  driveName  String
  capacityGB Int
  freeGB     Int
}

model InstalledSoftware {
  id        String  @id @default(cuid())
  assetId   String
  asset     Asset   @relation(fields: [assetId], references: [id], onDelete: Cascade)
  name      String
  publisher String?
  version   String?
}

model Attachment {
  id         String   @id @default(cuid())
  assetId    String
  asset      Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  fileName   String
  fileUrl    String
  fileType   String
  uploadedAt DateTime @default(now())
}

model TeledeployPackage {
  id          String           @id @default(cuid())
  name        String
  description String?
  osTarget    String
  scriptType  String
  payloadUrl  String?
  command     String
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  tasks       TeledeployTask[]
}

model TeledeployTask {
  id        String            @id @default(cuid())
  packageId String
  package   TeledeployPackage @relation(fields: [packageId], references: [id], onDelete: Cascade)
  assetId   String
  asset     Asset             @relation(fields: [assetId], references: [id], onDelete: Cascade)
  status    String            @default("PENDING")
  resultLog String?
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
}
