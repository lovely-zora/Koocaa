// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // REMOVE THE URL LINE FROM HERE
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  currency  String   @default("USD")
  users     User[]
  assets    Asset[]
  createdAt DateTime @default(now())
}

model User {
  id             String          @id @default(cuid())
  email          String          @unique
  password       String?
  name           String?
  role           String          @default("EMPLOYEE")
  organizationId String
  organization   Organization    @relation(fields: [organizationId], references: [id])
  assets         Asset[]
  history        AssetHistory[]
  ticketComments TicketComment[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

model Asset {
  id              String           @id @default(cuid())
  name            String
  assetTag        String           @unique
  category        String
  status          String           @default("AVAILABLE")
  organizationId  String
  organization    Organization     @relation(fields: [organizationId], references: [id])
  assignedToId    String?
  assignedTo      User?            @relation(fields: [assignedToId], references: [id])
  assignedAt      DateTime?        // Added for lifecycle tracking
  warrantyExpiry  DateTime?        // Added for lifecycle tracking
  history         AssetHistory[]
  maintenanceLogs MaintenanceLog[]
  attachments     Attachment[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
}

model AssetHistory {
  id        String   @id @default(cuid())
  assetId   String
  asset     Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  action    String
  notes     String?
  createdAt DateTime @default(now())
}

model Attachment {
  id         String   @id @default(cuid())
  assetId    String
  asset      Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  fileName   String
  fileUrl    String
  fileType   String
  uploadedAt DateTime @default(now())
}

model MaintenanceLog {
  id        String          @id @default(cuid())
  assetId   String
  asset     Asset           @relation(fields: [assetId], references: [id], onDelete: Cascade)
  issue     String
  status    String          @default("OPEN")
  priority  String          @default("MEDIUM")
  comments  TicketComment[]
  createdAt DateTime        @default(now())
  updatedAt DateTime        @default(now()) @updatedAt
}

model TicketComment {
  id               String         @id @default(cuid())
  maintenanceLogId String
  maintenanceLog   MaintenanceLog @relation(fields: [maintenanceLogId], references: [id], onDelete: Cascade)
  userId           String
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  message          String
  createdAt        DateTime       @default(now())
}