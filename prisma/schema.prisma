generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Organization {
  id            String   @id @default(cuid())
  name          String
  slug          String   @unique
  currency      String   @default("USD")
  activeModules String[] @default(["DASHBOARD", "ASSETS"])
  users         User[]
  assets        Asset[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime? @updatedAt
}

model User {
  id             String         @id @default(cuid())
  email          String         @unique
  password       String?
  name           String?
  role           String         @default("EMPLOYEE")
  organizationId String
  organization   Organization   @relation(fields: [organizationId], references: [id])
  assets         Asset[]
  history        AssetHistory[]
  comments       TicketComment[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime?      @updatedAt
}

model Asset {
  id              String              @id @default(cuid())
  name            String
  assetTag        String              @unique
  category        String
  status          String              @default("AVAILABLE")
  isDiscovered    Boolean             @default(false)
  organizationId  String
  organization    Organization        @relation(fields: [organizationId], references: [id])
  assignedToId    String?
  assignedTo      User?               @relation(fields: [assignedToId], references: [id])
  history         AssetHistory[]
  maintenanceLogs MaintenanceLog[]
  attachments     Attachment[]
  hardware        HardwareSpec?
  networks        NetworkInterface[]
  storage         StorageDrive[]
  software        InstalledSoftware[]
  teledeployTasks TeledeployTask[]
  createdAt       DateTime            @default(now())
  updatedAt       DateTime?           @updatedAt
}

model AssetHistory {
  id        String   @id @default(cuid())
  assetId   String
  asset     Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  action    String
  notes     String?
  createdAt DateTime @default(now())
}

model MaintenanceLog {
  id        String          @id @default(cuid())
  assetId   String
  asset     Asset           @relation(fields: [assetId], references: [id], onDelete: Cascade)
  issue     String
  status    String          @default("OPEN")
  priority  String          @default("LOW")
  comments  TicketComment[]
  createdAt DateTime        @default(now())
  updatedAt DateTime?       @updatedAt
}

model TicketComment {
  id        String         @id @default(cuid())
  ticketId  String
  ticket    MaintenanceLog @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorId  String
  author    User           @relation(fields: [authorId], references: [id])
  content   String
  createdAt DateTime       @default(now())
}

model HardwareSpec {
  id         String   @id @default(cuid())
  assetId    String   @unique
  asset      Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  osName     String?
  osVersion  String?
  cpuModel   String?
  ramTotalMB Int?
  lastSyncAt DateTime @default(now())
}

model NetworkInterface {
  id         String  @id @default(cuid())
  assetId    String
  asset      Asset   @relation(fields: [assetId], references: [id], onDelete: Cascade)
  macAddress String
  ipAddress  String?
}

model StorageDrive {
  id         String @id @default(cuid())
  assetId    String
  asset      Asset  @relation(fields: [assetId], references: [id], onDelete: Cascade)
  driveName  String
  capacityGB Int
  freeGB     Int
}

model InstalledSoftware {
  id        String  @id @default(cuid())
  assetId   String
  asset     Asset   @relation(fields: [assetId], references: [id], onDelete: Cascade)
  name      String
  publisher String?
  version   String?
}

model Attachment {
  id         String   @id @default(cuid())
  assetId    String
  asset      Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  fileName   String
  fileUrl    String
  fileType   String
  uploadedAt DateTime @default(now())
}

model TeledeployPackage {
  id          String           @id @default(cuid())
  name        String
  description String?
  osTarget    String
  scriptType  String
  payloadUrl  String?
  command     String
  createdAt   DateTime         @default(now())
  updatedAt   DateTime?        @updatedAt
  tasks       TeledeployTask[]
}

model TeledeployTask {
  id        String            @id @default(cuid())
  packageId String
  package   TeledeployPackage @relation(fields: [packageId], references: [id], onDelete: Cascade)
  assetId   String
  asset     Asset             @relation(fields: [assetId], references: [id], onDelete: Cascade)
  status    String            @default("PENDING")
  resultLog String?
  createdAt DateTime          @default(now())
  updatedAt DateTime?         @updatedAt
}
